{
  "name": "@local/dsh-session-split",
  "version": "2.0.1",
  "private": true,
  "description": "Open any session from its left-sidebar context menu in a full native conversation panel on the right.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "src",
    "build.mjs"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test",
    "check": "node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homes-mark/dsh-session-split.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "session",
    "split-view"
  ]
}
